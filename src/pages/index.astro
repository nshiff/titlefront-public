---
import Layout from '../layouts/Layout.astro';

// Fill in photo (path under /public), title and linkedin to show them.
const team: { name: string; photo?: string; title?: string; linkedin?: string }[] = [
  {
    name: 'Josh Gardner',
    photo: 'jg.jpeg',
    title: 'Operations Director',
    linkedin: 'https://www.linkedin.com/in/josh-gardner-a9b456b9/'
  },
  {
    name: 'Nate Shiff',
    photo: 'ns.jpeg',
    title: 'Software Developer Director',
    linkedin: 'https://www.linkedin.com/in/nate-shiff'
  },
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .join('');
---

<Layout
  title="Titlefront - Software for the home-buying process in the UK"
  description="Titlefront is building AutoEnquire, an AI document analysis solution seeking to dramatically decrease the typical length of a property transaction."
>
  <section class="hero">
    <div class="wrap">
      <h1>Software for the home-buying process in the UK</h1>
      <p class="lede">
        Titlefront is building AutoEnquire, an AI document analysis solution
        seeking to dramatically decrease the typical length of a property
        transaction.
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2 class="center">Titlefront is:</h2>
      <div class="team">
        {
          team.map((p) => (
            <div class="person">
              {p.photo ? (
                <img class="photo" src={p.photo} alt={p.name} width="128" height="128" />
              ) : (
                <div class="photo" aria-hidden="true">{initials(p.name)}</div>
              )}
              <div class="name">{p.name}</div>
              {p.title && <div class="role">{p.title}</div>}
              {p.linkedin && (
                <a href={p.linkedin} rel="noopener">LinkedIn</a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
